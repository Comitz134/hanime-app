<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shell_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/shell_foreground"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.5"
            android:text="@string/server_help"
            android:textColor="@color/shell_muted"
            android:textSize="13sp" />

        <!--
          What the updater knows: installed build, effective source, and what the
          last check returned. This is the answer to "the update check does not
          work" without anybody reading logcat.
        -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_status_title"
            android:textColor="@color/shell_foreground"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.45"
            android:textColor="@color/shell_muted"
            android:textSize="12sp"
            android:textIsSelectable="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/settings_check"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/shell_card"
                android:text="@string/settings_check_now"
                android:textColor="@color/shell_foreground"
                android:textSize="12sp" />

            <Button
                android:id="@+id/settings_copy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:backgroundTint="@color/shell_card"
                android:text="@string/settings_copy"
                android:textColor="@color/shell_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/shell_card" />

        <!--
          Which built-in manifest the updater consults: stable is the newest
          published release, beta is the channel-beta manifest (a rolling
          prerelease asset). A saved address below still wins over both.
        -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:labelFor="@id/settings_channel_stable"
            android:text="@string/settings_channel"
            android:textColor="@color/shell_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/settings_channel_stable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/shell_card"
                android:text="@string/channel_stable"
                android:textColor="@color/shell_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/settings_channel_beta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:backgroundTint="@color/shell_card"
                android:text="@string/channel_beta"
                android:textColor="@color/shell_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:labelFor="@id/settings_field"
            android:text="@string/server_label"
            android:textColor="@color/shell_muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/settings_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:autofillHints="url"
            android:hint="@string/server_hint"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@color/shell_foreground"
            android:textColorHint="@color/shell_muted"
            android:backgroundTint="@color/shell_primary" />

        <Button
            android:id="@+id/settings_default"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/shell_card"
            android:text="@string/settings_reset"
            android:textColor="@color/shell_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/settings_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/shell_primary"
                android:text="@string/save"
                android:textColor="@color/shell_on_primary" />

            <Button
                android:id="@+id/settings_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:backgroundTint="@color/shell_card"
                android:text="@string/cancel"
                android:textColor="@color/shell_foreground" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
